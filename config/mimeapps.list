[Default Applications]
# Images
image/png=org.gnome.Loupe.desktop
image/jpeg=org.gnome.Loupe.desktop
image/svg+xml=org.gnome.Loupe.desktop
# Video
video/mp4=io.github.diegopvlk.Cine.desktop
video/x-matroska=io.github.diegopvlk.Cine.desktop # .mkv
# Audio
audio/mpeg=org.gnome.Decibels
# Directories
inode/directory=org.gnome.Nautilus.desktop
# Text files
application/pdf=org.gnome.Papers.desktop
application/yaml=codium.desktop
text/plain=codium.desktop
text/markdown=codium.desktop
text/x-shellscript=vim.desktop
x-scheme-handler/stremio=stremio-enhanced.desktop
