#!/bin/bash

src=~/ArchX13/config/ghostty
dest=~/.config/ghostty
backups=~/.config/backups/ghostty

mkdir -p "$dest" "$backups"
# Move existing noctalia config to ~/.config/backups/noctalia if already exists
[ -f "$dest/config.ghostty" ] && mv "$dest/config.ghostty" "$backups/config.ghostty"
# Create ghostty dir if not exists and symlink files to it
mkdir -p ~/.config/ghostty/
# Have to use -f flag because ghostty automatically creates own config files
ln -sn ~/ArchX13/config/ghostty/config.ghostty ~/.config/ghostty/config.ghostty
