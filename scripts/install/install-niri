#!/bin/bash

src=~/ArchX13/config/niri
dest=~/.config/niri
backups=~/.config/backups/niri

# Get and validate display argument
conf=$(~/ArchX13/scripts/install/prompt-display "$1")

# If ~/.config/niri is symlinked, then remove it 
[ -L "$dest" ] && rm "$dest"

# Create target and backups dirs in case they don't exist
mkdir -p "$dest" "$backups"

# Back up existing regular (non-symlink) files before replacing them
for f in config.kdl monitors.kdl; do
    [ -f "$dest/$f" ] && [ ! -L "$dest/$f" ] && mv "$dest/$f" "$backups/$f"
done

# Symlink ~/ArchX13/config/niri/config.kdl -> ~/.config/niri/config.kdl
ln -sfn "$src/config.kdl" "$dest/config.kdl"
# Symlink monitor specific setup -> ~/.config/niri/monitors.kdl
ln -sfn "$src/monitors/$conf.kdl" "$dest/monitors.kdl"
# Copy noctalia.kdl only if it doesn't already exist (-n = no clobber)
cp -n "$src/noctalia-default.kdl" "$dest/noctalia.kdl"
