#!/bin/bash

# Get and validate display argument
conf=$(~/ArchX13/scripts/install/prompt-display "$1")

# Create backups dir in case doesn't exist
mkdir -p ~/.config/backups/
# Move existing noctalia config to ~/.config/backups/noctalia if already exists
[ -f ~/.config/noctalia ] && mv ~/.config/noctalia ~/.config/backups/noctalia
# Symlink ArchX13 noctalia config to ~/.config/noctalia
ln -sn ~/ArchX13/config/noctalia ~/.config/noctalia
# Symlink monitor specific setup to monitors/monitor.toml
ln -sn ~/ArchX13/config/noctalia/monitors/$conf.toml ~/ArchX13/config/noctalia/monitors/monitor.toml

# Regen noctalia templates from default background
# skipping this will make niri config invalid due to noctalia.kdl not existing
noctalia msg templates-apply
