#!/bin/bash

src=~/ArchX13/config/noctalia
dest=~/.config/noctalia
backups=~/.config/backups/noctalia

# Get and validate display argument
conf=$(~/ArchX13/scripts/install/prompt-display "$1")

# If ~/.config/noctalia is still the old directory symlink, remove it so we
# don't write into the repo through it
[ -L "$dest" ] && rm "$dest"

# Create target and backups dirs in case they don't exist
mkdir -p "$dest" "$backups"

# Remove dangling symlinks left behind by base files that no longer exist
find "$dest" -maxdepth 1 -xtype l -delete

# Back up existing regular (non-symlink) files before replacing them
for f in "$src"/base/*.toml; do
    name=$(basename "$f")
    [ -f "$dest/$name" ] && [ ! -L "$dest/$name" ] && mv "$dest/$name" "$backups/$name"
done
[ -f "$dest/monitors.toml" ] && [ ! -L "$dest/monitors.toml" ] && mv "$dest/monitors.toml" "$backups/monitors.toml"

# Symlink every ~/ArchX13/config/noctalia/base/*.toml -> ~/.config/noctalia/
# (noctalia automatically reads all top level config files in ~/.config/noctalia)
ln -sfn "$src"/base/*.toml "$dest/"
# Symlink monitor specific setup -> ~/.config/noctalia/monitors.toml
ln -sfn "$src/monitors/$conf.toml" "$dest/monitors.toml"

# Regen noctalia templates from default background
# skipping this will make niri config invalid due to noctalia.kdl not existing
noctalia msg templates-apply
